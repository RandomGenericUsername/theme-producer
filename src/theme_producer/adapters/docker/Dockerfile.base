# Base image: python:3.14-slim + the repo's frozen uv environment.
#
# AD-8: the build context is this repository root. Every COPY path below is
# relative to it, and no sibling or parent checkout is referenced. The sibling
# libraries enter from the git tags uv.lock pins, so the stage needs uv, git and
# CA certificates; an unreachable pin fails the build closed instead of
# resolving something newer.
FROM python:3.14-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir "uv==0.9.22"

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

RUN uv sync --frozen --no-dev --no-editable && \
    mkdir -p /home/tpruser && \
    chmod 777 /home/tpruser

ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/home/tpruser

CMD ["sleep", "infinity"]
