{#- rofi property names are [A-Za-z0-9-]+; Material role underscores become hyphens -#}
/* colors.rasi — generated from theme.json */
/* rofi identifiers cannot contain "_"; canonical theme.json role names are
   emitted with hyphens (for example on_surface -> on-surface, on_backdrop ->
   on-backdrop). */
* {
{% for name, color in vocabulary.items() %}
    {{ name|replace('_', '-') }}: {{ color.hex }};
{% endfor %}
{% for name, color in extra_roles %}
    {{ name|replace('_', '-') }}: {{ color.hex }};
{% endfor %}
{% for name, color in produced_roles %}
    {{ name|replace('_', '-') }}: {{ color.hex }};
{% endfor %}
{% for name, color in legacy.items() %}
    color{{ '%02d' % loop.index0 }}: {{ color.hex }};
{% endfor %}
}
