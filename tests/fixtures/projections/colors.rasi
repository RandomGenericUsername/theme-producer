/* colors.rasi — generated from theme.json */
/* rofi identifiers cannot contain "_"; canonical theme.json role names are
   emitted with hyphens (for example on_surface -> on-surface, on_backdrop ->
   on-backdrop). */
* {
    background: #000000;
    foreground: #fbd0aa;
    accent: #26201a;
    accent-muted: #000000;
    surface: #000000;
    on-surface: #fbd0aa;
    error: #26201a;
    warning: #cdaa8a;
    error-container: #4d4034;
    inverse-on-surface: #806a57;
    inverse-primary: #cdaa8a;
    inverse-surface: #fbd0aa;
    on-background: #000000;
    on-error: #26201a;
    on-error-container: #4d4034;
    on-primary: #806a57;
    on-primary-container: #cdaa8a;
    on-primary-fixed: #fbd0aa;
    on-primary-fixed-variant: #000000;
    on-secondary: #26201a;
    on-secondary-container: #4d4034;
    on-secondary-fixed: #806a57;
    on-secondary-fixed-variant: #cdaa8a;
    on-surface-variant: #000000;
    on-tertiary: #26201a;
    on-tertiary-container: #4d4034;
    on-tertiary-fixed: #806a57;
    on-tertiary-fixed-variant: #cdaa8a;
    outline: #fbd0aa;
    outline-variant: #000000;
    primary: #26201a;
    primary-container: #4d4034;
    primary-fixed: #806a57;
    primary-fixed-dim: #cdaa8a;
    scrim: #fbd0aa;
    secondary: #000000;
    secondary-container: #26201a;
    secondary-fixed: #4d4034;
    secondary-fixed-dim: #806a57;
    shadow: #cdaa8a;
    source-color: #fbd0aa;
    surface-bright: #26201a;
    surface-container: #4d4034;
    surface-container-high: #806a57;
    surface-container-highest: #cdaa8a;
    surface-container-low: #fbd0aa;
    surface-container-lowest: #000000;
    surface-dim: #26201a;
    surface-tint: #4d4034;
    surface-variant: #806a57;
    tertiary: #cdaa8a;
    tertiary-container: #fbd0aa;
    tertiary-fixed: #000000;
    tertiary-fixed-dim: #26201a;
    on-backdrop: #fbd0aa;
    color00: #000000;
    color01: #26201a;
    color02: #cdaa8a;
    color03: #000000;
    color04: #26201a;
    color05: #806a57;
    color06: #000000;
    color07: #fbd0aa;
    color08: #fbd0aa;
    color09: #4d4034;
    color10: #fbd0aa;
    color11: #26201a;
    color12: #4d4034;
    color13: #4d4034;
    color14: #806a57;
    color15: #000000;
}